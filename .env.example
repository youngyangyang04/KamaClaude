# ScottClaude 环境配置模板
# 用法：cp .env.example .env，然后按需修改

# ── Core Daemon ───────────────────────────────────────────────
SCOTT_HOST=127.0.0.1
SCOTT_PORT=7437

# ── Logging ───────────────────────────────────────────────────
SCOTT_LOG_LEVEL=INFO
# 留空则仅输出 stderr，不写文件
SCOTT_LOG_FILE=~/.scott/logs/core.log
# text（人工可读键值对）或 json（结构化，适合日志聚合）
SCOTT_LOG_FORMAT=text

# ── Config File ───────────────────────────────────────────────
# SCOTT_CONFIG=~/.scott/config.toml

# ── LLM（S1 阶段启用）────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# SCOTT_LLM_DEFAULT_MODEL=claude-sonnet-4-6
# SCOTT_MAX_STEPS=20
